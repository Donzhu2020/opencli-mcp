{
  "name": "opencli-mcp",
  "version": "0.1.0",
  "description": "OpenCLI reborn as an MCP-native browser runtime: Chrome-spawned host, object API + code mode, site capabilities, recon.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "opencli-mcp": "dist/src/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-extension.mjs && node scripts/copy-assets.mjs",
    "build:ext": "node scripts/build-extension.mjs",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist/",
    "extension/dist/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@jackwener/opencli": "^1.8.7",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "tree-sitter-javascript": "^0.25.0",
    "web-tree-sitter": "^0.27.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
